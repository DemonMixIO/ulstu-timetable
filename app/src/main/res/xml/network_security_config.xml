<?xml version="1.0" encoding="utf-8"?>
<!--
  Сайт расписания отдаётся только по HTTPS, поэтому cleartext запрещён,
  а доверяются только системные центры сертификации.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
